# External CTA destinations (https only).
# Zelle, Venmo, Stripe, RunSignup, Amazon wishlists, and similar checkout links all work.
# Unset or invalid values keep the example.com placeholders in index.html.
# Next.js reads these when the homepage is built. Redeploy after changing them.

HCH_REGISTER_URL=https://example.com/hch/register
HCH_DONATE_URL=https://example.com/hch/donate
HCH_WISHLIST_EVENT_OPS_URL=https://example.com/hch/wishlist/event-operations
HCH_WISHLIST_AMAZON_TARGET_URL=https://example.com/hch/wishlist/amazon-target
HCH_WISHLIST_COSTCO_VISA_URL=https://example.com/hch/wishlist/costco-visa
