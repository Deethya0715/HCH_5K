# External CTA destinations (https only).
# Zelle, Venmo, Stripe, RunSignup, Amazon wishlists, and similar checkout links all work.
# Unset or invalid values keep the example.com placeholders in index.html.
# Next.js reads these when the homepage is built. Redeploy after changing them.

HCH_REGISTER_URL=https://example.com/hch/register
HCH_DONATE_URL=https://example.com/hch/donate
HCH_WISHLIST_EVENT_OPS_URL=https://example.com/hch/wishlist/event-operations
HCH_WISHLIST_AMAZON_TARGET_URL=https://example.com/hch/wishlist/amazon-target
HCH_WISHLIST_COSTCO_VISA_URL=https://example.com/hch/wishlist/costco-visa

# Neon / Vercel Postgres. The app reads DATABASE_URL, then POSTGRES_URL.
# Put the real connection string in .env.local and in the Vercel project settings.
# Tribute hero photos and community trail check-ins are stored in this database.
DATABASE_URL=
POSTGRES_URL=

# Origin the Capacitor WebView loads. Read from the environment when you run
# `npm run cap:sync` (it is not loaded from this file automatically).
# Unset uses https://hopecopeheal.vercel.app. Set a LAN URL to load a machine
# running `npm start`. Set it empty to load the static files copied into www/.
# CAPACITOR_SERVER_URL=http://192.168.1.20:3000

# Password for the private tribute list at /admin/tributes.
# Use a long random value in .env.local and in the Vercel project settings.
ADMIN_SECRET_KEY=
