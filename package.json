{
  "name": "hope-cope-heal-5k",
  "version": "1.0.0",
  "private": true,
  "description": "Single-page event site for the Hope. Cope. Heal. Inaugural 5K, 10K & Family Festival",
  "scripts": {
    "build": "next build",
    "cap:sync": "npm run build && node scripts/prepare-capacitor-www.js && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "db:init": "node scripts/init-tributes.mjs",
    "dev": "tailwindcss -i ./src/input.css -o ./assets/styles.css --watch",
    "serve": "npx --yes serve .",
    "start": "next start"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/cli": "^4.1.13",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "next": "^14.2.35",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
